# Supabase (Frontend/Vite)
VITE_SUPABASE_PROJECT_ID= # The unique identifier for your Supabase project
VITE_SUPABASE_URL= # The API URL for your Supabase project (found in Settings > API)
VITE_SUPABASE_PUBLISHABLE_KEY= # The public anonymous key for your Supabase project (found in Settings > API)

# Supabase (Backend/Server-side)
SUPABASE_URL= # The API URL for your Supabase project (Server-side usage)
SUPABASE_PUBLISHABLE_KEY= # The public anonymous key for your Supabase project (Server-side usage)
SUPABASE_SERVICE_ROLE_KEY= # Secret service role key (Server-side ONLY - bypasses Row Level Security)
